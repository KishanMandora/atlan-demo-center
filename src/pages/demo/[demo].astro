---
export const prerender = false;
import { GET } from '@/pages/api/demo/[slug].json';
import Layout from '@/layouts/Layout.astro';
import Text from '@/components/ui/Text.vue';
import { Button } from '@/components/ui/button';
import { Card } from '@/components/molecules/card';
import Summary from '@/components/organisms/summry/Summary.vue';

let response = await GET(Astro);
const data = await response.json();

let demoData = data.item.fields;

const videoUrl = demoData.videoUrl.split('/');
const videoId = videoUrl[videoUrl.length - 1];
const filters = demoData.filters.join(', ');

const url = new URL('/api/demos.json', Astro.url);
if (filters.length) {
  url.searchParams.set('filters', filters);
}

const res = await fetch(url.toString());
if (!res.ok) {
  throw new Error(`Failed to fetch demos: ${res.status}`);
}
const { items: relatedDemos = [] } = await res.json();

const relatedDemosList = relatedDemos?.filter(
  (demo: any) => demo.link !== demoData.link
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{demoData.title} – Demo</title>
    <meta name="description" content={demoData.description ?? demoData.title} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="keywords" content={filters} />
    <meta name="author" content="Atlan" />
    <meta name="robots" content="index, follow" />
  </head>
  <body>
    <Layout>
      <div
        class="w-8/10 max-w-10xl mx-auto flex flex-wrap md:flex-nowrap gap-6 min-h-screen mb-12"
      >
        <div class="w-full md:w-2/3">
          <Text as="h1" size="text-4xl" weight="font-bold">
            {demoData.title}
          </Text>

          <iframe
            class="w-full h-107 mt-6"
            src=`https://www.youtube.com/embed/${videoId}`
            title="YouTube video player"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          >
          </iframe>

          <Text
            as="p"
            size="text-lg"
            weight="font-normal"
            color="text-muted-foreground"
            class="mt-4"
          >
            {demoData.excerpt}
          </Text>

          <div class="mt-6 flex gap-4">
            <Button variant="default" size="lg">
              <a
                href="https://atlan.com/demo/welcome/"
                target="_blank"
                rel="noopener noreferrer"
              >
                Explore Demo
              </a>
            </Button>
            <Button
              variant="outline"
              size="lg"
              class="border-primary border text-primary"
            >
              <a
                href="https://atlan.com/forms/talk-to-expert-contact/"
                target="_blank"
                rel="noopener noreferrer"
              >
                Book a demo
              </a>
            </Button>
          </div>

          <Text
            as="p"
            size="text-lg"
            weight="font-normal"
            color="text-muted-foreground"
            class="mt-6"
          >
            {demoData.description}
          </Text>

          <div
            class="mt-6 grid-cols-1 hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6"
          >
            {
              relatedDemosList.map((demo: any) => (
                <a href={`/demo/${demo.link}`}>
                  <Card
                    client:load
                    description={demo.description}
                    title={demo.title}
                    thumbnail={demo.thumbnail}
                    publishedDate={demo.publishedDate}
                    duration={demo.duration}
                    filters={demo.filters}
                    featured={demo.featured}
                    views={demo.views}
                  />
                </a>
              ))
            }
          </div>
        </div>

        <div class="w-full md:w-1/3">
          <div class="rounded-md p-4">
            <Summary videoUrl={demoData.videoUrl} client:load />
          </div>
        </div>

        <div class="mt-6 grid-cols-1 grid md:hidden gap-6">
          {
            relatedDemosList.map((demo: any) => (
              <a href={`/demo/${demo.link}`}>
                <Card
                  client:load
                  description={demo.description}
                  title={demo.title}
                  thumbnail={demo.thumbnail}
                  publishedDate={demo.publishedDate}
                  duration={demo.duration}
                  filters={demo.filters}
                  featured={demo.featured}
                  views={demo.views}
                />
              </a>
            ))
          }
        </div>
      </div>
    </Layout>
  </body>
</html>
