---
import Layout from '@/layouts/Layout.astro';
import DemosGrid from '@/components/DemosGrid.vue';
import Text from '@/components/ui/Text.vue';
import Filters from '@/components/Filters.vue';

const title = 'Atlan Demo Center';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Layout />
    <div
      class="bg-center bg-cover bg-primary opacity-100 py-15"
      style="background-image:url(/src/assets/images/hero-bg.svg);"
    >
      <Text
        as="h1"
        size="text-6xl"
        color="text-secondary"
        weight="font-bold"
        align="text-center"
        class="w-2/5 mx-auto mt-4"
      >
        Experience Atlan in action.
      </Text>
    </div>
    <div class="w-4/5 mx-auto flex">
      <div class="w-1/5 px-3">
        <div class="w-full sticky top-18 bg-white">
          <Filters client:load />
        </div>
      </div>

      <div class="w-4/5">
        <DemosGrid client:load />
      </div>
    </div>
  </body>
</html>
