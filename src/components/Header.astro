---
import { Image } from 'astro:assets';
import HeaderComp from '@/components/Header.vue';
import logo from '@/assets/images/atlan-blue.svg';
---

<header class="bg-white sticky top-0 z-20">
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between p-6 lg:px-8 bg-inherit"
    aria-label="Global"
  >
    <div class="flex lg:flex-1">
      <a href="#" class="-m-1.5 p-1.5">
        <span class="sr-only">Atlan</span>
        <Image
          src={logo}
          alt="atlan logo"
          height={24}
          width={76}
          loading="eager"
          fetchpriority="high"
        />
      </a>
    </div>
    <HeaderComp client:load />
  </nav>
</header>
