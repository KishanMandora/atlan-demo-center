    Products built with <span>❤️</span> for the Humans of Data
  </p>

  <div class="flex gap-6 mb-8">
    <a
      href="https://www.facebook.com/AtlanHQ/"
      target="_blank"
      aria-label="Facebook"
      class="hover:opacity-80"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-6 h-6 fill-secondary"
        viewBox="0 0 24 24"
      >
        <path
          d="M22 12a10 10 0 1 0-11.5 9.9v-7h-2v-2.9h2V9.6c0-2 1.2-3.1 3-3.1.9 0 1.8.1 2 .1v2.3h-1.1c-1.1 0-1.4.7-1.4 1.4v1.8h2.6l-.4 2.9h-2.2v7A10 10 0 0 0 22 12z"
